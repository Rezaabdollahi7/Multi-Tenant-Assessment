# Build context is the repository root; send only what the images need.
**/node_modules
**/dist
**/.next
**/.turbo
**/coverage
**/storybook-static
**/*.tsbuildinfo
**/*.log

# Never bake local secrets into an image.
**/.env
**/.env.*
!**/.env.example

.git
.github
.husky
.agents
.claude
docs
graphify-out
