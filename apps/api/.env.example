# Copy to apps/api/.env for local development (pnpm dev).
NODE_ENV=development
PORT=3001

# Matches docker/compose.yml when only postgres and redis run in Docker.
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=assessment

REDIS_HOST=localhost
REDIS_PORT=6379

# At least 32 characters each, and different from each other.
ACCESS_TOKEN_SECRET=replace-with-a-random-string-of-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-random-string-of-at-least-32-characters

# Access-token lifetime. Set to 60 to see session expiry within a minute.
ACCESS_TOKEN_TTL_SECONDS=900

# Outside production every sign-in code is this value (5 digits).
DEV_OTP=00000

# Optional comma-separated origins allowed to call the API directly.
# Not needed for the web app, which proxies /api on its own origin.
# CORS_ORIGIN=http://localhost:3000
