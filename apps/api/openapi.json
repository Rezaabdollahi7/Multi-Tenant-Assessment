  "info": {
    "title": "Secure Multi-Tenant Assessment Dashboard API",
    "description": "Sign in with POST /api/auth/request-otp then /api/auth/verify-otp; the session lives in httpOnly cookies.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "X-ACCESS"
      }
    },
    "schemas": {
      "RequestOtpDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "09911110001"
          }
        },
        "required": ["phone"]
      },
      "RequestOtpResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Verification code sent"
          },
          "remainingAttempts": {
            "type": "number",
            "description": "Wrong attempts left before a temporary lock"
          },
          "code": {
            "type": "string",
            "description": "Returned only outside production, so demos need no SMS",
            "example": "00000"
          }
        },
        "required": ["message", "remainingAttempts"]
      },
      "VerifyOtpDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "09911110001"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{5}$",
            "example": "00000",
            "minLength": 5,
            "maxLength": 5
          }
        },
        "required": ["phone", "code"]
      },
      "SuccessResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          }
        },
        "required": ["success"]
      },
      "Role": {
        "type": "string",
        "enum": ["ADMIN", "ANALYST", "VIEWER"]
      },
      "OrganizationSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["id", "name"]
      },
      "Permission": {
        "type": "string",
        "enum": [
          "dashboard:read",
          "project:read",
          "member:read",
          "finding:read",
          "finding:create",
          "finding:update",
          "finding:delete",
          "activity:read"
        ]
      },
      "CurrentUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ]
          },
          "organization": {
            "$ref": "#/components/schemas/OrganizationSummaryDto"
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Permission"
            }
          }
        },
        "required": [
          "id",
          "name",
          "phone",
          "role",
          "organization",
          "permissions"
        ]
      },
      "ProjectStatus": {
        "type": "string",
        "enum": ["PLANNED", "IN_PROGRESS", "COMPLETED", "ARCHIVED"]
      },
      "ProjectDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProjectStatus"
              }
            ]
          },
          "findingsCount": {
            "type": "number",
            "minimum": 0
          },
          "membersCount": {
            "type": "number",
            "minimum": 0
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "status",
          "findingsCount",
          "membersCount",
          "createdAt"
        ]
      },
      "PaginationMetaDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number",
            "minimum": 1
          },
          "limit": {
            "type": "number",
            "minimum": 1
          },
          "totalItems": {
            "type": "number",
            "minimum": 0
          },
          "totalPages": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": ["page", "limit", "totalItems", "totalPages"]
      },
      "ProjectListDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectDto"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMetaDto"
          }
        },
        "required": ["data", "meta"]
      },
      "SeverityBreakdownDto": {
        "type": "object",
        "properties": {
          "CRITICAL": {
            "type": "number"
          },
          "HIGH": {
            "type": "number"
          },
          "MEDIUM": {
            "type": "number"
          },
          "LOW": {
            "type": "number"
          },
          "INFO": {
            "type": "number"
          }
        },
        "required": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]
      },
      "ProjectDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProjectStatus"
              }
            ]
          },
          "findingsCount": {
            "type": "number",
            "minimum": 0
          },
          "membersCount": {
            "type": "number",
            "minimum": 0
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "severityBreakdown": {
            "$ref": "#/components/schemas/SeverityBreakdownDto"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "status",
          "findingsCount",
          "membersCount",
          "createdAt",
          "severityBreakdown"
        ]
      },
      "MemberDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ]
          },
          "roleInProject": {
            "type": "string",
            "nullable": true
          },
          "joinedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": ["userId", "name", "role", "roleInProject", "joinedAt"]
      },
      "FindingSeverity": {
        "type": "string",
        "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]
      },
      "FindingStatus": {
        "type": "string",
        "enum": ["OPEN", "IN_REVIEW", "RESOLVED", "ACCEPTED"]
      },
      "ProjectSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["id", "name"]
      },
      "UserSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true
          }
        },
        "required": ["id", "name"]
      },
      "FindingDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "severity": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FindingSeverity"
              }
            ]
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FindingStatus"
              }
            ]
          },
          "project": {
            "$ref": "#/components/schemas/ProjectSummaryDto"
          },
          "createdBy": {
            "$ref": "#/components/schemas/UserSummaryDto"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "severity",
          "status",
          "project",
          "createdBy",
          "createdAt",
          "updatedAt"
        ]
      },
      "FindingListDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FindingDto"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMetaDto"
          }
        },
        "required": ["data", "meta"]
      },
      "CreateFindingDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "severity": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FindingSeverity"
              }
            ]
          },
          "projectId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["title", "severity", "projectId"]
      },
      "UpdateFindingDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "severity": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FindingSeverity"
              }
            ]
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FindingStatus"
              }
            ]
          }
        }
      },
      "ProjectStatusBreakdownDto": {
        "type": "object",
        "properties": {
          "PLANNED": {
            "type": "number"
          },
          "IN_PROGRESS": {
            "type": "number"
          },
          "COMPLETED": {
            "type": "number"
          },
          "ARCHIVED": {
            "type": "number"
          }
        },
        "required": ["PLANNED", "IN_PROGRESS", "COMPLETED", "ARCHIVED"]
      },
      "DashboardSummaryDto": {
        "type": "object",
        "properties": {
          "projectsCount": {
            "type": "number",
            "minimum": 0
          },
          "findingsCount": {
            "type": "number",
            "minimum": 0
          },
          "severityBreakdown": {
            "$ref": "#/components/schemas/SeverityBreakdownDto"
          },
          "projectStatusBreakdown": {
            "$ref": "#/components/schemas/ProjectStatusBreakdownDto"
          }
        },
        "required": [
          "projectsCount",
          "findingsCount",
          "severityBreakdown",
          "projectStatusBreakdown"
        ]
      },
      "TrendPointDto": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "example": "2026-10-18",
            "description": "UTC calendar day"
          },
          "total": {
            "type": "number",
            "minimum": 0
          },
          "bySeverity": {
            "$ref": "#/components/schemas/SeverityBreakdownDto"
          }
        },
        "required": ["date", "total", "bySeverity"]
      },
      "ActivityAction": {
        "type": "string",
        "enum": ["finding.created", "finding.updated", "finding.deleted"]
      },
      "ActivityTargetType": {
        "type": "string",
        "enum": ["finding"]
      },
      "ActivityTargetDto": {
        "type": "object",
        "properties": {
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ActivityTargetType"
              }
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["type", "id", "name"]
      },
      "ActivityDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "action": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ActivityAction"
              }
            ]
          },
          "actor": {
            "$ref": "#/components/schemas/UserSummaryDto"
          },
          "target": {
            "$ref": "#/components/schemas/ActivityTargetDto"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": ["id", "action", "actor", "target", "createdAt"]
      }
    }
  }
}
